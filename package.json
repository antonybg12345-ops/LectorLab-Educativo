{
  "name": "lectorlab-red",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "LectorLab: tutor socrático con IA para el RED Más allá de las palabras",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "openai": "^5.20.0"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
