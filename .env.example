# 1) Copia este archivo y renómbralo como .env
# 2) Pega tu clave de OpenAI después del signo =
OPENAI_API_KEY=

# Valor heredado del respaldo; validar disponibilidad y opciones antes de usar IA real.
OPENAI_MODEL=gpt-5.6-luna

# Puerto local. Puedes dejarlo así.
PORT=3000

# Solo demostración local. No exponer a Internet antes de incorporar cuentas/permisos.
HOST=127.0.0.1
