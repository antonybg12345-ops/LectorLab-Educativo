# Lectura, actividades manuales, cuentas y Excel funcionan sin servicios externos.
HOST=127.0.0.1
PORT=3000

# IA opcional: configura ambos en el servidor con un modelo habilitado en tu cuenta.
# Nunca copies la clave al navegador. Sin estos valores se muestra guía sin IA.
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL embebido local por defecto; carpeta privada .data/postgres.
# Una sola instancia puede abrir esta carpeta. DATABASE_URL es alternativa externa.
LECTORLAB_DATA_DIR=
DATABASE_URL=

# Sheets opcional. Archivo de credencial exclusivo de este proyecto, fuera de Git.
# NO se usa automáticamente GOOGLE_APPLICATION_CREDENTIALS de la máquina.
LECTORLAB_GOOGLE_CREDENTIALS_FILE=

# Solo para despliegue HTTPS revisado; setup inicial se permite únicamente en loopback.
# NODE_ENV=production
# TRUST_PROXY=1
# ALLOW_INITIAL_SETUP=false
